# Public website
SSENSUUM_WEB_BASE_URL=http://localhost:3000

# Application/API behind the public site
SSENSUUM_API_BASE_URL=http://localhost:8000

# Optional admin URL if separated from the public app
SSENSUUM_ADMIN_BASE_URL=http://localhost:3000/admin

# Test users. Never commit real credentials.
SSENSUUM_MEMBER_PHONE=3310000001
SSENSUUM_MEMBER_PASSWORD=ChangeMe123!
SSENSUUM_ADMIN_EMAIL=qa-admin@example.com
SSENSUUM_ADMIN_PASSWORD=ChangeMe123!

# Route adapter. Change these values if the real backend uses different routes.
ROUTE_SERVICES=/services
ROUTE_THERAPISTS=/therapists
ROUTE_AVAILABILITY=/availability
ROUTE_RESERVATIONS=/reservations
ROUTE_PAYMENTS=/payments
ROUTE_PAYMENT_WEBHOOK=/payments/webhook
ROUTE_MEMBERSHIPS=/memberships
ROUTE_CUSTOMERS=/customers
ROUTE_ADMIN_BLOCKS=/admin/blocks
ROUTE_ADMIN_AGENDA=/admin/agenda

# Test-only webhook endpoint, if your backend exposes one in QA/STG.
# Leave empty until implemented.
ROUTE_TEST_PAYMENT_WEBHOOK=
